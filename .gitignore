/node_modules
/.next
/out
/build
*.tsbuildinfo
next-env.d.ts
.env*
.DS_Store
.gstack/
.data/
# Discovery run output — regenerated by `npm run discover:opportunities`.
scripts/opportunities-latest.json

# Scratch output dir for `NEXT_DIST_DIR=.next-build npm run build` — lets a
# production build run without fighting a live `next dev` over .next/
.next-build/
.next-verify/

# Blog Agent images when Supabase Storage is not configured. In production
# these go to the public `blog-media` bucket; locally they land here, and they
# are regenerated by the pipeline rather than committed.
/public/blog-media/

# Sample results spreadsheets from scripts/make-sample-results.mjs. Regenerated
# on demand and deterministic, so there is nothing to gain from committing them
# — and this keeps a real exam-branch sheet dropped here from being committed
# by accident.
/tmp/

# Large media and temp files
.claude/
ezgif-*/
public/globe-sequence/
public/hero-sequence/
public/whiteai-sequence/
supabase/.temp/
