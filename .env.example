# Copy to .env.local and fill in. .env* is gitignored.

# --- Gemini (campus assistant natural-reply layer) -------------------------
# Server-side only. Never prefix with NEXT_PUBLIC_ (that ships the key to the browser).
GEMINI_API_KEY=
# Optional. Comma-separated failover chain; omit to use the built-in default.
# Free-tier quota is per-model per-day (gemini-3-flash is only 20/day).
# GEMINI_MODEL=

# --- Supabase --------------------------------------------------------------
# Project: sdnvwkpvkowryaqqzcer
NEXT_PUBLIC_SUPABASE_URL=https://sdnvwkpvkowryaqqzcer.supabase.co

# Publishable key. Safe in the browser: RLS is enabled with no policies, so this
# key can only call the two SECURITY DEFINER RPCs granted to `anon`.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key ("sb_secret_..."), from Project Settings -> API Keys.
# Bypasses RLS entirely. Server-side only — a leak is full database access.
SUPABASE_SECRET_KEY=

# Marketing Studio backend: "supabase" | "file" | unset (auto-detect).
MARKETING_STORE=supabase

# Salt for hashing enquiry submitter IPs. Any long random string.
# Without it the hash is per-boot, which still works but loses rate limiting
# across restarts.
ENQUIRY_IP_SALT=

# --- Opportunity discovery (scripts/discover-opportunities.ts) -------------
# Exa does the semantic search: "find application pages for X", not keyword hits.
# https://dashboard.exa.ai
EXA_API_KEY=

# Firecrawl re-scrapes pages Exa returns empty — most ATS boards render
# client-side. Optional: without it those pages are skipped rather than
# extracted from thin text. https://firecrawl.dev
FIRECRAWL_API_KEY=

# --- Opportunities Agent (daily liveness sweep) ----------------------------
# Authorises the scheduled run at /api/opportunities/agent/run, and the blog
# agent's cron. Any long random string YOU choose — not a third-party key:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# When this is unset the cron path is CLOSED, not open. That is deliberate: the
# route fires dozens of outbound requests per call, so leaving it unauthenticated
# would be a denial-of-wallet hole. Admins can still press "Run now" in the
# dashboard, which authorises through their session instead.
#
# The sweep itself needs no API key at all — re-checking a URL is a plain HTTP
# request, so retirement of dead listings works with only the Supabase keys set.
CRON_SECRET=

# --- Supabase MCP (Claude Code / agent tooling only, not the app) ----------
# Personal Access Token ("sbp_..."), from https://supabase.com/dashboard/account/tokens
# This is NOT the publishable or secret key — it is an account-level token that
# lets agent tooling run migrations and inspect the schema. Read by .mcp.json.
SUPABASE_ACCESS_TOKEN=

# --- Marketing Studio admin ------------------------------------------------
# Without ADMIN_PIN the studio runs in DEV MODE with auth disabled.
ADMIN_PIN=
ADMIN_SESSION_SECRET=

# NOTE: The Opportunities Agent no longer requires EXA_API_KEY. Discovery runs
# on Gemini's googleSearch grounding (GEMINI_API_KEY above), using Google
# `site:` operators to scope the search to the ATS/career allowlist the way
# Exa's includeDomains did. Setting EXA_API_KEY is still supported by
# scripts/discover-opportunities.ts if you prefer that path.
